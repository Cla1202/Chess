<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grigio_scuro">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_play"
            android:layout_marginBottom="24dp"
            app:tint="@color/gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/partita_libera"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartGame"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:text="@string/gioca_ora"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            app:icon="@drawable/ic_friend"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayBot"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:text="@string/gioca_con_bot"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:icon="@drawable/ic_bot"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:backgroundTint="@color/arancione" />

    </LinearLayout>
</RelativeLayout>