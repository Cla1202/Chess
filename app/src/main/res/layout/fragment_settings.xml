<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/grigio_scuro">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/impostazioni"
            android:textSize="24sp" android:textColor="@color/white" android:textStyle="bold" android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/aspetto"
            android:textColor="@color/silver" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@color/grigio_carbone" android:padding="8dp" android:layout_marginBottom="24dp">

            <RelativeLayout
                android:id="@+id/layout_board_theme"
                android:layout_width="match_parent" android:layout_height="48dp" android:clickable="true" android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tema_scacchiera"
                    android:textColor="@color/white" android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/tv_board_theme_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grigio_fumo" />

            <RelativeLayout
                android:id="@+id/layout_piece_style"
                android:layout_width="match_parent" android:layout_height="48dp" android:clickable="true" android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stile_pezzi"
                    android:textColor="@color/white" android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/tv_piece_style_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preferenze"
            android:textColor="@color/silver" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@color/grigio_carbone" android:padding="8dp" android:layout_marginBottom="24dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attiva_timer"
                    android:textColor="@color/white"
                    android:layout_centerVertical="true" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grigio_fumo" />

            <RelativeLayout
                android:id="@+id/layout_language"
                android:layout_width="match_parent" android:layout_height="48dp" android:clickable="true" android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lingua"
                    android:textColor="@color/white" android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/tv_language_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grigio_fumo" />

            <RelativeLayout
                android:layout_width="match_parent" android:layout_height="48dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vibrazione"
                    android:textColor="@color/white" android:layout_centerVertical="true" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_vibration"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_reset_progress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset_progressi"
            android:backgroundTint="@color/grigio_fumo" android:textColor="@color/white" android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_exit_app"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/esci_app"
            android:backgroundTint="@color/red" android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>